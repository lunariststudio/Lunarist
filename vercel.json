{
  "version": 2,
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/api/eugene-card/(.*)",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    },
    {
      "source": "/api/v1/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "Access-Control-Allow-Origin", "value": "https://eugene-card-1.vercel.app"},
        {"key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS"},
        {"key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization"}
      ]
    }
  ],
  "rewrites": [
    {"source": "/oauth/authorize", "destination": "/api/lunarist?resource=oauth&action=authorize"},
    {"source": "/oauth/token", "destination": "/api/lunarist?resource=oauth&action=token"},
    {"source": "/oauth/userinfo", "destination": "/api/lunarist?resource=oauth&action=userinfo"},
    {"source": "/oauth/revoke", "destination": "/api/lunarist?resource=oauth&action=revoke"},
    {"source": "/oauth/session", "destination": "/api/lunarist?resource=oauth&action=session"},
    {"source": "/.well-known/oauth-authorization-server", "destination": "/api/lunarist?resource=oauth&action=metadata"},
    {"source": "/api/v1/me", "destination": "/api/lunarist?resource=oauth&action=userinfo"},
    {"source": "/api/oauth-admin", "destination": "/api/lunarist?resource=oauth-admin"},
    {"source": "/api/eugene-card/start", "destination": "/api/lunarist?resource=eugene-start"},
    {"source": "/api/eugene-card/callback", "destination": "/api/lunarist?resource=eugene-callback"},
    {"source": "/api/eugene-card/revoke", "destination": "/api/lunarist?resource=eugene-revoke"},
    {"source": "/api/eugene-card/status", "destination": "/api/lunarist?resource=eugene"},
    {"source": "/", "has": [{"type":"query","key":"eugene_authorize"}], "destination": "/eugene-authorize-entry.html"},
    {"source": "/(.*)", "destination": "/index.html"}
  ]
}
