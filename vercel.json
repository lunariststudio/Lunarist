{
  "version": 2,
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/api/eugene-card/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "Access-Control-Allow-Origin", "value": "https://eugene-card-1.vercel.app"},
        {"key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS"},
        {"key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization"},
        {"key": "Access-Control-Allow-Credentials", "value": "true"}
      ]
    },
    {
      "source": "/api/eugene-connect",
      "headers": [
        {"key": "Access-Control-Allow-Origin", "value": "*"},
        {"key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS"},
        {"key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization"}
      ]
    },
    {
      "source": "/oauth/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/api/v1/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "Access-Control-Allow-Origin", "value": "https://eugene-card-1.vercel.app"},
        {"key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS"},
        {"key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization"}
      ]
    }
  ],
  "rewrites": [
    {"source": "/oauth/authorize", "destination": "/api/oauth?action=authorize"},
    {"source": "/oauth/token", "destination": "/api/oauth?action=token"},
    {"source": "/oauth/userinfo", "destination": "/api/oauth?action=userinfo"},
    {"source": "/oauth/revoke", "destination": "/api/oauth?action=revoke"},
    {"source": "/oauth/session", "destination": "/api/oauth?action=session"},
    {"source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth?action=metadata"},
    {"source": "/api/v1/me", "destination": "/api/v1?resource=me"},
    {"source": "/api/eugene-card/authorize", "destination": "/api/lunarist?resource=eugene-authorize"},
    {"source": "/api/eugene-card/token", "destination": "/api/lunarist?resource=eugene-token"},
    {"source": "/api/eugene-card/revoke", "destination": "/api/lunarist?resource=eugene-revoke"},
    {"source": "/api/eugene-card/session", "destination": "/api/lunarist?resource=eugene-session"},
    {"source": "/api/eugene-connect", "destination": "/api/lunarist?resource=eugene"},
    {"source": "/", "has": [{"type":"query","key":"eugene_authorize"}], "destination": "/eugene-authorize-entry.html"},
    {"source": "/(.*)", "destination": "/index.html"}
  ]
}
